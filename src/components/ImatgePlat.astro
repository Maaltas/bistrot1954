---
/**
 * Foto d'un plat (dis. §6.2-§6.3, arq. §6.3-§6.5): <Picture> AVIF + WebP + JPEG dins d'una finestra rodona.
 * La imatge es genera sencera i es mostra al 112,5 % de l'amplada de la finestra, pujada un 25 %: es veu el quadrat
 * de x 0-88,9 % i y 16,7-83,3 % de la captura, i queden fora la fletxa del carrusel i els punts d'Instagram.
 * Cap sortida si no hi ha imatge.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { calculaWidths } from '../lib/imatges';

interface Props {
  imatge: ImageMetadata | null;
  alt: string;
  /** La primera foto de la pàgina és prioritària; les altres es carreguen en diferit. */
  primera?: boolean;
}
const { imatge, alt, primera = false } = Astro.props;
---
{
  imatge && (
    <div class="foto">
      <Picture
        src={imatge}
        alt={alt}
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        widths={calculaWidths(imatge.width)}
        sizes="(min-width: 900px) 338px, 293px"
        quality={60}
        loading={primera ? 'eager' : 'lazy'}
        fetchpriority={primera ? 'high' : undefined}
        decoding="async"
      />
    </div>
  )
}

<style>
  .foto {
    width: var(--cercle);
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: var(--radi-foto);
    background: var(--vi-clar);
  }

  .foto :global(picture) {
    display: block;
  }

  .foto :global(img) {
    display: block;
    width: 112.5%;
    max-width: none;
    height: auto;
    margin-top: -25%;
  }
</style>
