---
/**
 * Article d'un plat (dis. §4; ganxos d'arq. §4.5). Ordre al DOM: nom, foto, història, enllaç.
 * L'ordre visual (foto, nom, història, enllaç) el fa l'ordre de flex, sense canviar l'ordre de lectura ni el del focus.
 */
import type { Plat } from '../lib/contingut';
import type { Idioma } from '../lib/idioma';
import { textos } from '../i18n/textos';
import ImatgePlat from './ImatgePlat.astro';
import Historia from './Historia.astro';

interface Props {
  plat: Plat;
  lang: Idioma;
  primera?: boolean;
}
const { plat, lang, primera = false } = Astro.props;
const nom = plat.nom[lang];
const historia = plat.historia[lang];
const senseFoto = plat.imatge === null;
const t = textos[lang];
---
<article id={plat.id} data-plat-id={plat.id} class:list={['plat', { 'plat--sense-foto': senseFoto }]}>
  <h3 class="plat__nom" lang={nom.lang !== lang ? nom.lang : undefined}>{nom.text}</h3>
  {
    !senseFoto && (
      <div class="plat__foto">
        <ImatgePlat imatge={plat.imatge} alt={nom.text} primera={primera} />
      </div>
    )
  }
  {
    historia && (
      <div class="plat__historia">
        <Historia historia={historia} paginaLang={lang} />
      </div>
    )
  }
  <a class="plat__enllac" href={plat.urlPost} rel="noopener">
    {senseFoto ? t.enllacPlatSenseFoto : t.enllacPlat}<span class="nomes-lectors">: {nom.text}</span>
  </a>
</article>

<style>
  .plat {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 100%;
  }

  /* Mòbil: entre plat i plat, 56 px + un filet senzill or de 48 px + 56 px. Després de l'últim, res. */
  .plat:not(:last-child)::after {
    content: '';
    order: 5;
    width: 48px;
    height: 0;
    margin-top: 56px;
    border-top: var(--filet-senzill);
  }

  .plat + .plat {
    margin-top: 56px;
  }

  .plat__foto {
    order: 1;
  }

  .plat__nom {
    order: 2;
    margin-top: var(--espai-5);
    font-size: var(--mida-plat);
    line-height: var(--interlineat-plat);
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  .plat__historia {
    order: 3;
    width: 100%;
    margin-top: var(--espai-3);
  }

  .plat__enllac {
    order: 4;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: var(--espai-4);
    font-family: var(--tipus-sans);
    font-weight: 500;
    font-size: var(--mida-ui);
    line-height: var(--interlineat-ui);
  }

  /* Sense foto: nom sense marge superior i cap cercle buit (dis. §4.3). */
  .plat--sense-foto .plat__nom {
    margin-top: 0;
  }

  /* Escriptori: la carta oberta, dues columnes de 480 px (text de 400 px) amb filet vertical doble a l'esquerra
     dels plats parells (corregeix la maqueta). Cap filet horitzontal. */
  @media (min-width: 900px) {
    .plat,
    .plat + .plat {
      margin-top: 0;
      padding-inline: 40px;
    }

    .plat:not(:last-child)::after {
      display: none;
    }

    .plat:nth-child(even) {
      border-left: var(--filet-doble);
    }
  }
</style>
