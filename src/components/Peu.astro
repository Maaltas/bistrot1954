---
/** Peu (dis. §3.5): filet doble, nom en cursiva vi, Instagram, avís legal i selector d'idioma. */
import type { Restaurant } from '../lib/contingut';
import type { Idioma } from '../lib/idioma';
import { ruta } from '../lib/entorn';
import { RUTES, type Pagina } from '../lib/rutes';
import { textos } from '../i18n/textos';
import SelectorIdioma from './SelectorIdioma.astro';

interface Props {
  lang: Idioma;
  pagina: Pagina;
  restaurant: Restaurant;
}
const { lang, pagina, restaurant } = Astro.props;
const t = textos[lang];
---
<footer class="peu">
  <div class="contenidor">
    <div class="filet-doble" aria-hidden="true"></div>
    <p class="peu__nom">{restaurant.nom}</p>
    <ul class="peu__enllacos">
      <li><a class="peu__enllac" href={restaurant.instagram} rel="noopener">{t.instagram}</a></li>
      <li><a class="peu__enllac" href={ruta(RUTES.legal[lang])}>{t.avisLegal}</a></li>
      <li><SelectorIdioma lang={lang} pagina={pagina} /></li>
    </ul>
  </div>
</footer>

<style>
  .peu {
    padding-top: var(--espai-2);
    /* Reserva l'espai de la barra inferior (72 px) perquè no tapi el peu. */
    padding-bottom: calc(var(--barra-inf-alt) + var(--espai-4) + env(safe-area-inset-bottom));
  }

  .peu__nom {
    margin-top: var(--espai-5);
    font-style: italic;
    font-size: var(--mida-peu-nom);
    line-height: 1.3;
    color: var(--vi);
  }

  .peu__enllacos {
    font-family: var(--tipus-sans);
    font-weight: 500;
    font-size: var(--mida-ui);
    line-height: var(--interlineat-ui-llarg);
  }

  .peu__enllac,
  .peu__enllacos :global(.idioma) {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  /* Mòbil apaïsat: la barra inferior no és fixa i no cal reservar-li espai. */
  @media (max-height: 479px) {
    .peu {
      padding-bottom: var(--espai-4);
    }
  }

  @media (min-width: 900px) {
    .peu {
      padding-bottom: var(--espai-7);
    }

    /* Els tres enllaços, en una sola fila, centrats i separats 24 px. */
    .peu__enllacos {
      display: flex;
      justify-content: center;
      gap: var(--espai-6);
    }
  }
</style>
