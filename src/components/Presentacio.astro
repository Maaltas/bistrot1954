---
/** Text de presentació del restaurant (arq. §4.3.2): literal de l'Oriol, sense emojis. Centrat (dis. §3.2). */
import type { Historia } from '../lib/contingut';
import type { Idioma } from '../lib/idioma';
import Paragrafs from './Paragrafs.astro';

interface Props {
  presentacio: Historia;
  paginaLang: Idioma;
}
const { presentacio, paginaLang } = Astro.props;
---
<div class="presentacio" data-presentacio lang={presentacio.lang !== paginaLang ? presentacio.lang : undefined}>
  <Paragrafs paragrafs={presentacio.paragrafs} />
</div>

<style>
  .presentacio {
    max-width: var(--mesura-curta);
    margin-inline: auto;
    font-size: var(--mida-presentacio);
    line-height: var(--interlineat-text);
    color: var(--tinta);
    text-align: center;
    text-wrap: pretty;
    overflow-wrap: anywhere;
  }

  .presentacio :global(p + p) {
    margin-top: 0.6em;
  }

  @media (min-width: 900px) {
    .presentacio {
      max-width: var(--mesura);
    }
  }
</style>
