---
/**
 * Obertura (#inici): la capçalera de la carta (dis. §3.2). Ordre: selector, nom, filet doble, cuina,
 * presentació, horari, adreça, filet doble.
 */
import type { Restaurant } from '../lib/contingut';
import type { Idioma } from '../lib/idioma';
import { cuinaDe } from '../lib/seo';
import { formataHorari } from '../i18n/textos';
import Presentacio from './Presentacio.astro';
import SelectorIdioma from './SelectorIdioma.astro';

interface Props {
  lang: Idioma;
  restaurant: Restaurant;
}
const { lang, restaurant } = Astro.props;
const cuina = cuinaDe(restaurant, lang);
const horari = formataHorari(restaurant.horari, lang);
const presentacio = restaurant.presentacio[lang];
const { adreca } = restaurant;
---
<section id="inici" class="obertura">
  <div class="contenidor">
    <div class="obertura__idioma">
      <SelectorIdioma lang={lang} pagina="portada" />
    </div>
    <h1 class="obertura__nom">{restaurant.nom}</h1>
    <div class="filet-doble obertura__filet" aria-hidden="true"></div>
    {cuina && <p class="obertura__cuina">{cuina}</p>}
    {presentacio && <div class="obertura__presentacio"><Presentacio presentacio={presentacio} paginaLang={lang} /></div>}
    <div class="obertura__dades">
      <div class="obertura__horari">{horari.map((linia) => <p>{linia}</p>)}</div>
      <address class="obertura__adreca"><span class="obertura__carrer">{adreca.carrer}</span><span class="obertura__coma">, </span><span class="obertura__poble">{adreca.codi_postal} {adreca.municipi}</span></address>
    </div>
    <div class="filet-doble obertura__filet obertura__filet--final" aria-hidden="true"></div>
  </div>
</section>

<style>
  .obertura {
    padding-bottom: var(--espai-7);
  }

  .obertura__idioma {
    display: flex;
    justify-content: flex-end;
    padding-top: var(--espai-2);
  }

  .obertura__nom {
    margin-top: var(--espai-4);
    font-size: var(--mida-marca);
    line-height: var(--interlineat-marca);
    text-wrap: balance;
  }

  .obertura__filet {
    margin-top: var(--espai-3);
  }

  .obertura__cuina {
    margin-top: var(--espai-3);
    font-family: var(--tipus-sans);
    font-weight: 500;
    font-size: var(--mida-ui);
    line-height: var(--interlineat-ui);
    color: var(--fum);
  }

  .obertura__presentacio {
    margin-top: var(--espai-6);
  }

  .obertura__dades {
    margin-top: var(--espai-6);
    font-family: var(--tipus-sans);
    font-weight: 500;
    font-size: var(--mida-ui);
    line-height: var(--interlineat-ui-llarg);
    color: var(--tinta);
  }

  .obertura__adreca {
    margin-top: var(--espai-1);
  }

  .obertura__horari {
    text-wrap: balance;
  }

  .obertura__carrer,
  .obertura__poble {
    display: block;
  }

  .obertura__coma {
    display: none;
  }

  .obertura__filet--final {
    margin-top: var(--espai-6);
  }

  @media (min-width: 900px) {
    .obertura {
      padding-top: calc(var(--barra-sup-alt) + var(--espai-9));
      padding-bottom: var(--espai-8);
    }

    .obertura__idioma {
      display: none;
    }

    .obertura__nom {
      margin-top: 0;
    }

    .obertura__filet {
      width: 220px;
    }

    .obertura__dades {
      display: flex;
      align-items: center;
      justify-content: center;
      margin-top: var(--espai-7);
      font-size: 1.125rem;
    }

    .obertura__horari {
      padding-right: var(--espai-7);
    }

    .obertura__adreca {
      margin-top: 0;
      padding-block: var(--espai-1);
      padding-left: var(--espai-7);
      border-left: var(--filet-doble);
    }

    .obertura__carrer,
    .obertura__poble {
      display: inline;
    }

    .obertura__coma {
      display: inline;
    }

    .obertura__filet--final {
      margin-top: var(--espai-7);
    }
  }
</style>
