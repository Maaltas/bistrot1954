---
/**
 * Pàgina 404 bilingüe (dis. §3.6, arq. §5.2). GitHub Pages la serveix per a qualsevol ruta inexistent,
 * per això els enllaços són absoluts (amb `base`) i no porta cap recurs relatiu. Sense barres ni fotos.
 */
import Base from '../layouts/Base.astro';
import { getRestaurant } from '../lib/contingut';
import { ruta } from '../lib/entorn';
import { RUTES } from '../lib/rutes';
import { textos404 } from '../i18n/textos';

const restaurant = getRestaurant();
---
<Base
  lang="ca"
  title={`${textos404.ca.missatge} · ${restaurant.nom}`}
  description={`${textos404.ca.missatge} ${textos404.es.missatge}`}
  noindex
  senseEstadistiques
>
  <main class="pagina">
    <p class="marca">{restaurant.nom}</p>
    <div class="filet-doble pagina__filet" aria-hidden="true"></div>
    <h1 class="missatge" lang="ca">{textos404.ca.missatge}</h1>
    <p><a class="enllac" href={ruta(RUTES.portada.ca)} lang="ca">{textos404.ca.enllac}</a></p>
    <div class="filet-senzill pagina__separador" aria-hidden="true"></div>
    <p class="missatge" lang="es">{textos404.es.missatge}</p>
    <p><a class="enllac" href={ruta(RUTES.portada.es)} lang="es">{textos404.es.enllac}</a></p>
  </main>
</Base>

<style>
  .pagina {
    padding-block: var(--espai-8);
  }

  .marca {
    font-style: italic;
    font-size: var(--mida-404-marca);
    line-height: var(--interlineat-titol);
    color: var(--vi);
  }

  .pagina__filet {
    margin-top: var(--espai-3);
    margin-bottom: var(--espai-7);
  }

  .pagina__separador {
    margin-block: var(--espai-7);
  }

  /* Els missatges van en rodona i tinta (EB Garamond), com diu el wireframe. */
  .missatge {
    font-style: normal;
    font-size: var(--mida-404-missatge);
    line-height: 1.3;
    color: var(--tinta);
  }

  .enllac {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--tipus-sans);
    font-weight: 500;
    font-size: var(--mida-ui);
    line-height: var(--interlineat-ui);
  }

  @media (min-width: 900px) {
    .pagina {
      padding-block: var(--espai-10);
    }
  }
</style>
